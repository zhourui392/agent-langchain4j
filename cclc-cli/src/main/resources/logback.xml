<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="LOG_DIR" value="${user.home}/.claude-code-j/logs"/>
    <property name="CCLC_LOG_LEVEL" value="${CCLC_LOG_LEVEL:-INFO}"/>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/cclc.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/cclc.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%X{session:-};t%X{turn:-};%X{toolUseId:-}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.anthropic.cclc.application" level="${CCLC_LOG_LEVEL:-INFO}"/>
    <logger name="com.anthropic.cclc.infrastructure.tools" level="${CCLC_LOG_LEVEL:-INFO}"/>
    <logger name="com.anthropic.cclc.infrastructure.llm" level="${CCLC_LOG_LEVEL:-INFO}"/>
    <logger name="com.anthropic.cclc.infrastructure.diagnosis" level="${CCLC_LOG_LEVEL:-INFO}"/>
    <logger name="dev.langchain4j" level="DEBUG"/>
    <logger name="dev.ai4j" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="FILE"/>
    </root>
</configuration>
